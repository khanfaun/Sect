{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "phu-sinh:tuyen-v1",
  "title": "Tuyến mệnh (xuất thân OR01–OR45 / đại lộ DL01–DL09) — một tệp content/tuyen/<id>.json",
  "description": "Bộ kiểm thật là tools/kiem-tra-tuyen.js (npm run content:tuyen): ngoài cấu trúc còn kiểm mã có thật, chữ không có số, không ghi tên cứng, 5 nút, 3 kết, dấu kết tới được. Hướng dẫn: docs/content/HUONG-DAN-GPT-VIET-TUYEN.md.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "id", "loai", "ten", "nut", "ket"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "id": { "type": "string", "pattern": "^(OR(0[1-9]|[1-3][0-9]|4[0-5])|DL0[1-9])$" },
    "loai": { "enum": ["xuat_than", "dai_lo"] },
    "ten": { "type": "string", "minLength": 1 },
    "xuatThan": { "type": "string", "description": "Mã xuất thân (chỉ tuyến xuat_than)" },
    "daiLo": { "$ref": "#/$defs/daiLo", "description": "Chỉ tuyến dai_lo" },
    "goiYDaiLo": { "type": "array", "items": { "$ref": "#/$defs/daiLo" } },
    "tomTat": { "type": "string", "description": "Ghi chú biên tập, không hiện trong game" },
    "mo": { "type": "object", "additionalProperties": false, "properties": { "tuoiTu": { "type": "integer", "minimum": 16, "maximum": 80 }, "dk": { "$ref": "#/$defs/dk" } } },
    "vatTruyen": { "type": "array", "items": { "type": "object", "additionalProperties": false, "required": ["id", "n", "d"], "properties": { "id": { "type": "string", "pattern": "^vt_[a-z0-9]+_[a-z0-9_]+$" }, "n": { "type": "string" }, "i": { "type": "string" }, "d": { "type": "string" } } } },
    "nut": { "type": "array", "minItems": 5, "maxItems": 5, "items": { "$ref": "#/$defs/nut" } },
    "ket": { "type": "array", "minItems": 3, "maxItems": 3, "items": { "$ref": "#/$defs/ket" } },
    "ngoai": { "type": "string", "description": "Dòng Sử lược khi không đạt kết nào (người đứng ngoài)" },
    "ketMo": { "type": "string", "description": "Lời dẫn khi người chơi được chọn giữa nhiều kết" }
  },
  "$defs": {
    "daiLo": { "enum": ["phi_thang", "diet_the", "de_nghiep", "phu_giap", "huyet_cuu", "vo_lam", "the_gia", "y_gia", "tinh_mong"] },
    "thoiGian": { "type": "object", "additionalProperties": false, "properties": { "nam": { "type": "integer", "minimum": 0 }, "thang": { "type": "integer", "minimum": 0 } } },
    "dau": { "type": "array", "items": { "type": "string", "pattern": "^[a-z][a-z0-9_]{1,40}$" } },
    "dk": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "dau": { "$ref": "#/$defs/dau" }, "khongDau": { "$ref": "#/$defs/dau" },
        "pham": { "type": "boolean" }, "canhGioiTu": { "type": "integer", "minimum": 0, "maximum": 5 },
        "tuoiTu": { "type": "integer" }, "tuoiDen": { "type": "integer" }, "bacTu": { "type": "integer", "minimum": 0 },
        "linhThachTu": { "$ref": "#/$defs/linhThach" }, "vatPham": { "type": "array", "items": { "type": "string" } },
        "vaiSong": { "type": "array", "items": { "type": "string", "pattern": "^NP[0-9]{2}$" } }, "vaiMat": { "type": "array", "items": { "type": "string", "pattern": "^NP[0-9]{2}$" } },
        "faSong": { "type": "array", "items": { "type": "string", "pattern": "^FA[0-9]{2}$" } }, "faDiet": { "type": "array", "items": { "type": "string", "pattern": "^FA[0-9]{2}$" } },
        "clkDang": { "type": "array", "items": { "type": "string", "pattern": "^CLK[0-9]{2}$" } }, "khoa": { "type": "string" }
      }
    },
    "linhThach": { "type": "object", "additionalProperties": false, "properties": { "ha": { "type": "integer" }, "trung": { "type": "integer" }, "thuong": { "type": "integer" }, "cuc": { "type": "integer" } } },
    "clk": { "type": "object", "additionalProperties": false, "required": ["id", "kq"], "properties": { "id": { "type": "string", "pattern": "^CLK[0-9]{2}$" }, "kq": { "type": "string" } } },
    "e": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "bac": { "type": "integer", "description": "Tiền phàm, đơn vị xu (1 lượng bạc = 1000 xu)" },
        "linhThach": { "$ref": "#/$defs/linhThach" },
        "deed": { "oneOf": [{ "type": "string" }, { "type": "array", "items": { "type": "string" } }] },
        "vatPham": { "oneOf": [{ "type": "string" }, { "type": "array", "items": { "type": "string" } }] },
        "boVatPham": { "oneOf": [{ "type": "string" }, { "type": "array", "items": { "type": "string" } }] },
        "fa": { "type": "object", "patternProperties": { "^FA[0-9]{2}$": { "type": "integer", "minimum": -10, "maximum": 10 } }, "additionalProperties": false },
        "clk": { "$ref": "#/$defs/clk" }, "giet": { "type": "string", "pattern": "^NP[0-9]{2}$" },
        "hp": { "type": "string", "pattern": "^-?[0-9]{1,2}%$" }, "h": { "type": "integer", "minimum": 1, "maximum": 720 }, "tamma": { "type": "integer", "minimum": -15, "maximum": 15 }
      }
    },
    "cach": {
      "type": "object", "additionalProperties": false, "required": ["id", "l", "t"],
      "properties": { "id": { "type": "string", "pattern": "^[a-z][a-z0-9_]{0,30}$" }, "l": { "type": "string" }, "t": { "type": "string" }, "dk": { "$ref": "#/$defs/dk" }, "e": { "$ref": "#/$defs/e" }, "dau": { "$ref": "#/$defs/dau" }, "boQua": { "const": true } }
    },
    "nut": {
      "type": "object", "additionalProperties": false, "required": ["id", "ten", "loiMoi", "han", "mo", "cach", "tuDien"],
      "properties": {
        "id": { "enum": ["N1", "N2", "N3", "N4", "N5"] }, "ten": { "type": "string" },
        "cho": { "$ref": "#/$defs/thoiGian" }, "han": { "$ref": "#/$defs/thoiGian" }, "dk": { "$ref": "#/$defs/dk" },
        "loiMoi": { "type": "object", "additionalProperties": false, "required": ["cach"], "properties": { "cach": { "enum": ["thu", "nguoi", "tin", "ky_ngo"] }, "noi": { "type": "string", "pattern": "^(LOC[0-9]{2}|here)$" }, "vai": { "type": "string", "pattern": "^NP[0-9]{2}$" } } },
        "mo": { "type": "string", "minLength": 120 }, "thayThe": { "type": "string" },
        "cach": { "type": "array", "minItems": 3, "maxItems": 5, "items": { "$ref": "#/$defs/cach" } },
        "tuDien": { "type": "object", "additionalProperties": false, "required": ["t"], "properties": { "t": { "type": "string" }, "su": { "type": "string" }, "dau": { "$ref": "#/$defs/dau" }, "clk": { "$ref": "#/$defs/clk" } } },
        "clk": { "type": "string", "pattern": "^CLK[0-9]{2}$" }, "khacVoi": { "type": "string" }, "boQuaNeuXuatThan": { "type": "boolean" }
      }
    },
    "ket": {
      "type": "object", "additionalProperties": false, "required": ["id", "ten", "dk", "t", "su", "dauVong"],
      "properties": { "id": { "enum": ["A", "B", "C"] }, "ten": { "type": "string" }, "dk": { "$ref": "#/$defs/dk" }, "t": { "type": "string" }, "su": { "type": "string" }, "dauVong": { "type": "string" }, "e": { "$ref": "#/$defs/e" } }
    }
  }
}
